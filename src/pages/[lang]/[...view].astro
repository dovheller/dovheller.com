---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import ContactForm from '../../components/ContactForm.astro';
import { labels, languages, views, type Language, type View } from '../../lib/site';

export function getStaticPaths() {
  return languages.flatMap(language => views.map(view => ({
    params: {lang: language, view: view === 'home' ? undefined : view},
    props: {language, view},
  })));
}
interface Props { language: Language; view: View }
const { language, view } = Astro.props;
const he = language === 'he';
const title = labels[language][view];
const isContent = view === 'capabilities' || view === 'proofs' || view === 'approach';
const collection = view === 'capabilities' ? 'capabilities' : view === 'proofs' ? 'proofs' : 'pages';
const entries = isContent ? (await getCollection(collection, ({data}) => data.language === language))
  .sort((a,b) => a.data.order - b.data.order) : [];
const rendered = await Promise.all(entries.map(async entry => ({...entry, ...(await entry.render()) })));
const summary = {
  he: { home: 'דב הלר, חזן לשעבר, יזם ומייסד הלר דיגיטל בירושלים.', about: 'דב הלר, מייסד הלר דיגיטל ויזם מירושלים.', capabilities: 'פיתוח תוכנה ו־Android, הגנת מערכות, אנליטיקה וליווי.', cyber: 'תמונת מצב של סיכוני סייבר בישראל ותרחישים מעשיים לעסקים.', proofs: 'שלושה פרויקטים בתחומי איסוף נתוני שטח, מסחר והנדסת מוצר.', approach: 'אפיון, פיילוט, הפעלה ומסירה.', contact: 'יצירת קשר עם הלר דיגיטל.' },
  en: { home: 'Dov Heller, former cantor, entrepreneur and founder of HDIGITAL in Jerusalem.', about: 'Dov Heller, Jerusalem entrepreneur and founder of HDIGITAL.', capabilities: 'Software and Android development, cybersecurity and analytics.', cyber: 'Cyber risk in Israel and practical scenarios for businesses.', proofs: 'Three projects in field data collection, commerce and product engineering.', approach: 'Specification, pilot, rollout and handover.', contact: 'Contact HDIGITAL.' }
};
---
<Shell {language} {view} title={view === 'home' ? (he ? 'דב הלר · ירושלים, יזמות וטכנולוגיה' : 'Dov Heller · Jerusalem, business, and technology') : `${title} · HDIGITAL`} description={summary[language][view]}>
  {isContent && <div class="technical-page">
    <h1>{title}</h1>
    {rendered.map(({data, Content}) => <article class="entry">
      {view !== 'approach' && <h2>{data.title}</h2>}
      <Content />
      {data.url && <p><a href={data.url} dir="ltr">{new URL(data.url).hostname}</a></p>}
    </article>)}
  </div>}
  {view === 'contact' && <div class="technical-page"><h1>{title}</h1><ContactForm {language}/></div>}
</Shell>
